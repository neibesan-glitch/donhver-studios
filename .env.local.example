# ============================================================================
# Donhver Studios — Variables d'environnement
# ============================================================================
# Copiez ce fichier en .env.local et remplissez les valeurs.
# NE JAMAIS commiter .env.local (il est dans .gitignore).
# ============================================================================

# --- OpenRouter (chatbot) ---
# Clé API à récupérer sur https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Modèle gratuit par défaut (peut être surchargé). Quelques options gratuites
# actuellement disponibles (vérifié 2026-07-03) :
#   nvidia/nemotron-3-ultra-550b-a55b:free  (meilleur, FR propre, recommandé)
#   nvidia/nemotron-3-super-120b-a12b:free  (bon fallback)
#   google/gemma-4-26b-a4b-it:free          (Google Gemma 4)
# NB : la route /api/chat teste automatiquement plusieurs modèles en fallback
# si celui-ci est saturé. Voir app/api/chat/route.ts (FREE_MODELS_FALLBACK).
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# URL publique du site (servira pour les headers OpenRouter)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (leads + chat) ---
# À récupérer sur https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ATTENTION : clé serveur — ne JAMAIS exposer côté navigateur.
# Utilisée uniquement dans app/api/chat/route.ts pour écrire les leads.
SUPABASE_SERVICE_ROLE_KEY=

# --- Vercel Blob (hébergement des vidéos finales) ---
# Uniquement pour l'upload (script portfolio/scripts/video-upload/).
# NE PAS exposer côté navigateur (pas de préfixe NEXT_PUBLIC_).
#
# Récupération :
#   1. https://vercel.com/dashboard → projet → onglet Storage
#   2. Create Database → Blob → nommer "portfolio-videos"
#   3. Copier le BLOB_READ_WRITE_TOKEN affiché à la création
BLOB_READ_WRITE_TOKEN=

